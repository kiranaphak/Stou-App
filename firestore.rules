rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Anonymous quiz completion sessions
    match /quizSessions/{sessionId} {
      // Allow reading aggregated results
      allow read: if true;
      
      // Allow anonymous session creation with validation
      allow create: if request.resource.data.sessionId is string
                    && request.resource.data.scores is map
                    && request.resource.data.answers is map
                    && request.resource.data.primaryPersona is string;
      
      // Prevent modification or deletion of past sessions
      allow update, delete: if false;
    }
  }
}
